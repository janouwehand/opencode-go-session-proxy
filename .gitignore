appsettings.Development.json
appsettings.*.local.json
*.local.json
.env
.env.*
!.env.example

# Session state written by the proxy when Proxy:SessionStorePath points into the repo
session.json

# Logs and crash dumps
*.log
logs/
*.dmp
*.stackdump

# Publish/runtime leftovers
*.pdb
*.cache

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
