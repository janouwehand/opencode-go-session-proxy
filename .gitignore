# Build output
bin/
obj/
publish/
artifacts/

# Visual Studio / Rider / VS Code user state
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# Test and coverage output
TestResults/
*.trx
coverage/
coverage.*
*.coverage
*.coveragexml

# Local configuration and secrets
